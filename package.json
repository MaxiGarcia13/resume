{
  "name": "resume",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Portfolio and CV of Maxi Garcia Mortigliengo, Senior Frontend Software Engineer. Explore projects, skills, and professional experience.",
  "author": "Maximiliano Garcia Mortigliengo",
  "homepage": "https://github.com/MaxiGarcia13/resume#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MaxiGarcia13/resume.git"
  },
  "keywords": [
    "resume",
    "cv",
    "portfolio",
    "Maximiliano Garcia Mortigliengo",
    "Maxi Garcia Mortigliengo",
    "frontend",
    "software engineer",
    "Frontend Software Engineer",
    "Senior Frontend Software Engineer",
    "Frontend Developer",
    "Software Engineer",
    "Software Developer",
    "Web Engineer",
    "Web Developer"
  ],
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "build:force": "npm run clean:build && astro build --force",
    "preview": "astro preview",
    "generate:cv": "node --import tsx/esm scripts/generate-cv.ts",
    "generate:project-previews": "node --import tsx/esm scripts/generate-project-previews.ts",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "test": "vitest run",
    "postinstall": "npx simple-git-hooks",
    "clean:build": "rm -rf dist .astro public/assets/project-previews",
    "clean": "npm run clean:build && rm -rf node_modules .vercel package-lock.json",
    "phoenix": "npm run clean && npm install"
  },
  "dependencies": {
    "@astrojs/react": "^7.1.1",
    "@maxigarcia/access-token": "^1.0.2",
    "@maxigarcia/ai-router": "^0.1.1",
    "@maxigarcia/js-utils": "^1.22.1",
    "@maxigarcia/view-transitions": "^0.9.0",
    "@mlc-ai/web-llm": "^0.2.86",
    "@nanostores/react": "^2.0.1",
    "@react-pdf/renderer": "^4.9.0",
    "astro": "^7.4.2",
    "nanostores": "^1.5.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vercel": "^11.0.16",
    "@eslint-react/eslint-plugin": "^5.28.8",
    "@maxigarcia/eslint-config": "^1.17.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint-plugin-astro": "^3.2.1",
    "lint-staged": "^17.6.0",
    "prettier-plugin-astro": "^1.1.2",
    "sharp": "^0.35.5",
    "simple-git-hooks": "^2.14.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "vitest": "^5.0.5"
  },
  "simple-git-hooks": {
    "pre-commit": "npx lint-staged"
  },
  "lint-staged": {
    "*": "eslint --fix"
  },
  "allowScripts": {
    "simple-git-hooks@2.14.0": true,
    "esbuild@0.28.2": true
  }
}
