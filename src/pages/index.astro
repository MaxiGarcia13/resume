---
import Ai from '@/components/ai/ai.astro';
import Header from '@/components/header.astro';
import Education from '@/components/profile/education.astro';
import Languages from '@/components/profile/languages.astro';
import Projects from '@/components/profile/projects.astro';
import WorksExperience from '@/components/profile/works-experience.astro';
import SwitchTheme from '@/components/switch-theme.astro';
import AppLayout from '@/layouts/app.astro';

export const prerender = true;
---

<AppLayout>
  <main class="flex flex-col gap-10 max-w-225 mx-auto min-h-screen">
    <div class="fixed z-10 right-6 top-4 flex gap-2 backdrop-blur-sm rounded-sm">
      <SwitchTheme class="w-10" />
      <Ai class="w-10" server:defer />
    </div>
    <Header />
    <Languages />
    <WorksExperience />
    <Education />
    <Projects />
  </main>
</AppLayout>
