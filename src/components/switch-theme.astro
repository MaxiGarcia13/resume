---
import Button from './shared/actions/button.astro';
import MoonIcon from './shared/icons/moon.astro';
import SunIcon from './shared/icons/sun.astro';

interface Props {
  class?: string;
}

const { class: className } = Astro.props;
---

<Button type="button" id="switch-theme" class={className} data-switch-theme aria-label="Toggle color theme">
  <Fragment slot="icon">
    <MoonIcon class="hidden dark:block" />
    <SunIcon class="block dark:hidden" />
  </Fragment>
</Button>

<script>
  import type { SweepDirection } from '@maxigarcia/view-transitions';
  import { onSweepRevealAnimation } from '@maxigarcia/view-transitions';
  import { initializeThemeStore, toggleTheme } from '@/modules/theme';

  initializeThemeStore();

  const switchThemeButton = document.getElementById('switch-theme');

  function isDarkMode() {
    return document.documentElement.dataset.theme === 'dark';
  }

  function syncThemeToggleLabel() {
    const label = isDarkMode() ? 'Switch to light theme' : 'Switch to dark theme';

    switchThemeButton?.setAttribute('aria-label', label);
  }

  syncThemeToggleLabel();

  switchThemeButton?.addEventListener('click', () => {
    const direction: SweepDirection = isDarkMode() ? 'corner-top-right' : 'corner-bottom-left';

    onSweepRevealAnimation(
      () => {
        toggleTheme();
        syncThemeToggleLabel();
      },
      direction,
      {
        blur: true,
        blurAmount: '20px',
      },
    );
  });
</script>
