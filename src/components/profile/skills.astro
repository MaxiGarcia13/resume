---
import type { Skill } from '@/types/skills';
import Text from '../shared/text/text.astro';

const { skills = [], class: className }: { skills?: Skill[]; class?: string } = Astro.props;
---

<div class:list={[className, 'flex flex-wrap gap-2']}>
  {
    skills.map((skill) => {
      const Icon = skill.icon;

      return (
        <Text variant="ghost" tag="span" class="text-xs flex gap-1 items-center justify-start">
          {Icon ? <Icon class="size-4" /> : null}

          {skill.name}

          {skills.indexOf(skill) < skills.length - 1 ? ',' : '.'}
        </Text>
      );
    })
  }
</div>
