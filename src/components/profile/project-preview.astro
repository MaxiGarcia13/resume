---
import { cn } from '@maxigarcia/js-utils';
import Link from '@/components/shared/actions/link/link.astro';
import ImgLoader from '@/components/shared/img-loader.astro';
import {
  PROJECT_PREVIEW_WIDTHS,
  getProjectPreviewSlug,
  getProjectPreviewSrc,
  getProjectPreviewSrcSet,
} from '@/utils/project-preview';

interface Props {
  src: string;
  title: string;
  class?: string;
}

const { src, title, class: className } = Astro.props;

const previewId = `preview-${getProjectPreviewSlug(title)}`;
const srcSet = getProjectPreviewSrcSet(title);
const defaultSrc = getProjectPreviewSrc(title, PROJECT_PREVIEW_WIDTHS.at(-1)!);
---

<Link
  href={src}
  target="_blank"
  noWrap
  class={cn('block relative', className)}
  aria-label={`${title} website (opens in new tab)`}
>
  <ImgLoader id={previewId}>
    <img
      id={previewId}
      src={defaultSrc}
      srcset={srcSet}
      sizes="(max-width: 900px) 100vw, 900px"
      alt={`Preview of ${title}`}
      width={900}
      height={506}
      loading="lazy"
      decoding="async"
      class={cn('w-full h-auto overflow-hidden rounded-sm', className)}
    />
  </ImgLoader>
</Link>
