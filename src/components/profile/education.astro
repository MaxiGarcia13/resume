---
import Link from '@/components/shared/actions/link/link.astro';
import Heading from '@/components/shared/heading/heading.astro';
import ExternalLinkIcon from '@/components/shared/icons/external-link.astro';
import Text from '@/components/shared/text/text.astro';
import { formatScheduleDuration } from '@/utils';
import { getCvAnchorId } from '@/utils/link-cv-anchors';
import { getEducation } from '@/data/education';

const education = getEducation();
---

<section id="work-experience" class="flex flex-col gap-4">
  <Heading tag="h2">
    <Link href="#education" noWrap>Education</Link>
  </Heading>
  <ul class="flex flex-col gap-4">
    {
      education.map(({ institution, degree, url, schedule, location }) => {
        const id = getCvAnchorId(degree);

        return (
          <li class="flex flex-col gap-2">
            <Heading id={id} tag="h4" class="group flex gap-2 items-center justify-start">
              <div class="flex gap-2 flex-wrap items-center justify-start">
                <Link href={`#${id}`} noWrap>
                  {degree}
                </Link>
                <Text tag="span" class="text-sm!">
                  at
                </Text>
                <Text tag="span" class="text-sm!">
                  {institution}
                </Text>
              </div>
              <Link href={url} target="_blank" aria-label={`${institution} website (opens in new tab)`}>
                <ExternalLinkIcon slot="icon" width={18} height={18} />
              </Link>
            </Heading>

            <Text tag="span" class="flex gap-1">
              {location} - {formatScheduleDuration(schedule)}
            </Text>
          </li>
        );
      })
    }
  </ul>
</section>
