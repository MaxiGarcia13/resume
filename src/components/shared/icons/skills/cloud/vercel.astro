---
import type { IconProps } from '@/components/shared/icons/type';
import { DEFAULT_ICON_SIZE } from '../../constans';

const { class: className, width = DEFAULT_ICON_SIZE, height = DEFAULT_ICON_SIZE, ...props }: IconProps = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={width}
  height={height}
  {...props}
>
  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
  <path d="M3 19h18l-9 -15l-9 15"></path>
</svg>
