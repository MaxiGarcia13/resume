---
import type { IconProps } from '@/components/shared/icons/type';
import { DEFAULT_ICON_SIZE } from '../../constans';

const { class: className, width = DEFAULT_ICON_SIZE, height = DEFAULT_ICON_SIZE, ...props }: IconProps = Astro.props;
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  width="24"
  height="24"
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="2"
  stroke-linecap="round"
  stroke-linejoin="round"
  class={className}
  width={width}
  height={height}
  {...props}
>
  <path stroke="none" d="M0 0h24v24H0z" fill="none"></path>
  <path d="M3.296 14.297l6.407 6.407a9.018 9.018 0 0 1 -6.325 -6.116l-.082 -.291"></path>
  <path d="M16 13h5c-.41 3.603 -3.007 6.59 -6.386 7.614l-11.228 -11.229a9 9 0 0 1 15.66 -2.985"></path>
</svg>
